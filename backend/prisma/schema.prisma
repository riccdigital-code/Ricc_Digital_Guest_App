datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//////////////////////////////////////////////////////////
// 🏢 PROPERTY CORE
//////////////////////////////////////////////////////////
// ... rest of your models (keep everything from here down)

//////////////////////////////////////////////////////////
// 🏢 PROPERTY
//////////////////////////////////////////////////////////

model Property {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  createdAt DateTime @default(now())

  rooms             Room[]
  users             User[]
  bookings          Booking[]
  sessions          GuestSession[]
  orders            Order[]
  serviceCategories ServiceCategory[]
  serviceItems      ServiceItem[]
  serviceRequests   ServiceRequest[]
  tasks             Task[]
  supportRequests   SupportRequest[]
  callLogs          CallLog[]
}

//////////////////////////////////////////////////////////
// 🗂️ SERVICE CATEGORY
//////////////////////////////////////////////////////////

model ServiceCategory {
  id         Int      @id @default(autoincrement())
  propertyId Int
  name       String
  isActive   Boolean  @default(true)
  type       String // "request" | "order"
  createdAt  DateTime @default(now())

  property Property      @relation(fields: [propertyId], references: [id])
  items    ServiceItem[]
}

//////////////////////////////////////////////////////////
// 🍽️ SERVICE ITEM
//////////////////////////////////////////////////////////

model ServiceItem {
  id         Int      @id @default(autoincrement())
  propertyId Int
  categoryId Int
  name       String
  price      Float?
  isPaid     Boolean  @default(false)
  isActive   Boolean  @default(true) // ✅ FIXED: was isAvailable
  createdAt  DateTime @default(now())

  property   Property         @relation(fields: [propertyId], references: [id])
  category   ServiceCategory  @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  requests   ServiceRequest[]
}

//////////////////////////////////////////////////////////
// 🏠 ROOM — permanent QR anchor
//////////////////////////////////////////////////////////

model Room {
  id         Int      @id @default(autoincrement())
  propertyId Int
  roomNumber String
  roomToken  String   @unique
  floor      String?
  roomType   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  property Property       @relation(fields: [propertyId], references: [id])
  sessions GuestSession[]
  bookings Booking[]

  callLogs CallLog[]

  @@map("rooms")
}

//////////////////////////////////////////////////////////
// 📅 BOOKING
//////////////////////////////////////////////////////////

model Booking {
  id            Int       @id @default(autoincrement())
  propertyId    Int
  firstName     String
  surname       String
  phone         String
  roomNumber    String
  roomId        Int?
  checkInDate   DateTime  @default(now())
  checkoutDate  DateTime? // ✅ FIXED: consistent lowercase
  status        String    @default("pending")
  paymentStatus String    @default("pending")
  createdAt     DateTime  @default(now())

  property Property       @relation(fields: [propertyId], references: [id])
  room     Room?          @relation(fields: [roomId], references: [id])
  sessions GuestSession[]
}

//////////////////////////////////////////////////////////
// 👤 GUEST SESSION
//////////////////////////////////////////////////////////

model GuestSession {
  id         Int      @id @default(autoincrement())
  propertyId Int
  roomId     Int
  firstName  String
  surname    String
  phone      String
  roomNumber String
  status     String   @default("active")
  bookingId  Int?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])
}

//////////////////////////////////////////////////////////
// 🍔 ORDER
//////////////////////////////////////////////////////////

model Order {
  id         Int      @id @default(autoincrement())
  propertyId Int
  roomNumber String
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  property Property    @relation(fields: [propertyId], references: [id])
  items    OrderItem[]
}

//////////////////////////////////////////////////////////
// 🍔 ORDER ITEM
//////////////////////////////////////////////////////////

model OrderItem {
  id            Int    @id @default(autoincrement())
  orderId       Int
  serviceItemId Int
  quantity      Int
  status        String @default("pending")

  order       Order       @relation(fields: [orderId], references: [id])
  serviceItem ServiceItem @relation(fields: [serviceItemId], references: [id])
  tasks       Task[]
}

//////////////////////////////////////////////////////////
// 🧹 SERVICE REQUEST
//////////////////////////////////////////////////////////

model ServiceRequest {
  id            Int      @id @default(autoincrement())
  propertyId    Int
  roomNumber    String
  serviceItemId Int
  note          String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  property    Property    @relation(fields: [propertyId], references: [id])
  serviceItem ServiceItem @relation(fields: [serviceItemId], references: [id])
  tasks       Task[]
}

//////////////////////////////////////////////////////////
// 🔥 TASK ENGINE
//////////////////////////////////////////////////////////

model Task {
  id           Int      @id @default(autoincrement())
  propertyId   Int
  itemName     String
  status       String   @default("pending")
  priority     String   @default("normal") // ✅ FIXED: was "medium"
  assignedToId Int?
  orderItemId  Int?
  requestId    Int?
  callLogId    Int?     @unique
  createdAt    DateTime @default(now())

  property        Property         @relation(fields: [propertyId], references: [id])
  assignedTo      User?            @relation("UserTasks", fields: [assignedToId], references: [id])
  orderItem       OrderItem?       @relation(fields: [orderItemId], references: [id])
  request         ServiceRequest?  @relation(fields: [requestId], references: [id])
  callLog         CallLog?         @relation(fields: [callLogId], references: [id])
  supportRequests SupportRequest[]
}

//////////////////////////////////////////////////////////
// 👥 USER
//////////////////////////////////////////////////////////

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  role       String
  propertyId Int?
  createdAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id]) // ✅ FIXED: optional
  tasks    Task[]    @relation("UserTasks")
}

//////////////////////////////////////////////////////////
// 🆘 SUPPORT REQUEST
//////////////////////////////////////////////////////////

model SupportRequest {
  id         Int      @id @default(autoincrement())
  propertyId Int
  roomNumber String
  phone      String?
  status     String   @default("open")
  taskId     Int?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  task     Task?    @relation(fields: [taskId], references: [id])
}

//////////////////////////////////////////////////////////
// 📞 CALL LOG
//////////////////////////////////////////////////////////

model CallLog {
  id         Int      @id @default(autoincrement())
  propertyId Int
  roomId     Int?
  roomNumber String
  phone      String?
  callType   String   @default("SUPPORT")
  urgency    String   @default("normal")
  status     String   @default("pending")
  notes      String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  room     Room?    @relation(fields: [roomId], references: [id])
  task     Task?

  @@index([propertyId])
  @@index([roomId])
  @@index([status])
  @@map("call_logs")
}
