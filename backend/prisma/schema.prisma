datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Property {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms             Room[]
  users             User[]
  bookings          Booking[]
  sessions          GuestSession[]
  orders            Order[]
  serviceCategories ServiceCategory[]
  serviceItems      ServiceItem[]
  serviceRequests   ServiceRequest[]
  tasks             Task[]
  supportRequests   SupportRequest[]
  callLogs          CallLog[]
}

model ServiceCategory {
  id         Int      @id @default(autoincrement())
  propertyId Int
  name       String
  isActive   Boolean  @default(true)
  type       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property      @relation(fields: [propertyId], references: [id])
  items    ServiceItem[]

  @@unique([propertyId, name, type])
  @@index([propertyId])
}

model ServiceItem {
  id         Int      @id @default(autoincrement())
  propertyId Int
  categoryId Int
  name       String
  price      Decimal? @db.Decimal(10, 2)
  isPaid     Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property   Property        @relation(fields: [propertyId], references: [id])
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  requests   ServiceRequest[]

  @@unique([propertyId, categoryId, name])
  @@index([propertyId])
  @@index([categoryId])
}

model Room {
  id         Int      @id @default(autoincrement())
  propertyId Int
  roomNumber String
  roomToken  String   @unique
  floor      String?
  roomType   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property       @relation(fields: [propertyId], references: [id])
  sessions GuestSession[]
  bookings Booking[]
  callLogs CallLog[]

  @@unique([propertyId, roomNumber])
  @@index([propertyId])
  @@map("rooms")
}

model Booking {
  id            Int       @id @default(autoincrement())
  propertyId    Int
  firstName     String
  surname       String
  phone         String
  roomNumber    String
  roomId        Int?
  checkInDate   DateTime  @default(now())
  checkoutDate  DateTime?
  status        String    @default("pending")
  paymentStatus String    @default("pending")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  property Property       @relation(fields: [propertyId], references: [id])
  room     Room?          @relation(fields: [roomId], references: [id])
  sessions GuestSession[]

  @@index([propertyId])
  @@index([roomId])
}

model GuestSession {
  id         Int      @id @default(autoincrement())
  propertyId Int
  roomId     Int
  firstName  String
  surname    String
  phone      String
  roomNumber String
  status     String   @default("active")
  bookingId  Int?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@index([propertyId])
  @@index([roomId])
  @@index([status])
}

model Order {
  id         Int      @id @default(autoincrement())
  propertyId Int
  roomNumber String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property    @relation(fields: [propertyId], references: [id])
  items    OrderItem[]

  @@index([propertyId])
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  serviceItemId Int
  quantity      Int
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order       Order       @relation(fields: [orderId], references: [id])
  serviceItem ServiceItem @relation(fields: [serviceItemId], references: [id])
  tasks       Task[]

  @@index([orderId])
  @@index([serviceItemId])
}

model ServiceRequest {
  id            Int      @id @default(autoincrement())
  propertyId    Int
  roomNumber    String
  serviceItemId Int
  note          String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property    Property    @relation(fields: [propertyId], references: [id])
  serviceItem ServiceItem @relation(fields: [serviceItemId], references: [id])
  tasks       Task[]

  @@index([propertyId])
  @@index([serviceItemId])
}

model Task {
  id           Int      @id @default(autoincrement())
  propertyId   Int
  itemName     String
  status       String   @default("pending")
  priority     String   @default("normal")
  assignedToId Int?
  orderItemId  Int?
  requestId    Int?
  callLogId    Int?     @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property        Property        @relation(fields: [propertyId], references: [id])
  assignedTo      User?           @relation("UserTasks", fields: [assignedToId], references: [id])
  orderItem       OrderItem?      @relation(fields: [orderItemId], references: [id])
  request         ServiceRequest? @relation(fields: [requestId], references: [id])
  callLog         CallLog?        @relation(fields: [callLogId], references: [id])
  supportRequests SupportRequest[]

  @@index([propertyId])
  @@index([assignedToId])
  @@index([status])
  @@index([propertyId, status])
  @@index([assignedToId, status])
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  role       String
  propertyId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id])
  tasks    Task[]    @relation("UserTasks")

  @@index([propertyId])
  @@index([role])
  @@index([propertyId, role])
}

model SupportRequest {
  id         Int      @id @default(autoincrement())
  propertyId Int
  roomNumber String
  phone      String?
  status     String   @default("open")
  taskId     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  task     Task?    @relation(fields: [taskId], references: [id])

  @@index([propertyId])
}

model CallLog {
  id         Int      @id @default(autoincrement())
  propertyId Int
  roomId     Int?
  roomNumber String
  phone      String?
  callType   String   @default("SUPPORT")
  urgency    String   @default("normal")
  status     String   @default("pending")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  room     Room?    @relation(fields: [roomId], references: [id])
  task     Task?

  @@index([propertyId])
  @@index([roomId])
  @@index([status])
  @@map("call_logs")
}